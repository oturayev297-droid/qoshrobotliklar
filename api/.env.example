# PostgreSQL ulanish satri (Railway "Add plugin -> PostgreSQL" qo'shsangiz avtomatik beriladi)
DATABASE_URL="postgresql://user:password@localhost:5432/qoshrabotliklar"

# JWT tokenlarni imzolash uchun maxfiy kalit — ishlab chiqarishda uzun, tasodifiy qiymat qo'ying
# Masalan: openssl rand -base64 48
JWT_SECRET="o'zgartiring-va-uzun-tasodifiy-satr-qiling"

# Frontend manzili (CORS uchun), bir nechta bo'lsa vergul bilan ajrating
CORS_ORIGIN="http://localhost:3000,https://qoshrabotliklar.vercel.app"

PORT=4000
NODE_ENV=development

# `npm run seed` ishga tushirilganda yaratiladigan birinchi admin
SEED_ADMIN_EMAIL="admin@qoshrabot.uz"
SEED_ADMIN_PASSWORD="ChangeMe123!"
